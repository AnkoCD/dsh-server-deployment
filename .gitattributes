# Normalize line endings: shell scripts and services must stay LF on any OS
* text=auto
*.js   text eol=lf
*.cjs  text eol=lf
*.ts   text eol=lf
*.sh   text eol=lf
*.svg  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.service text eol=lf
*.conf text eol=lf
bin/*          text eol=lf
units/*.service text eol=lf
